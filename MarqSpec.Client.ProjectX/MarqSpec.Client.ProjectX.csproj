<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Both targets are first-class; a change must compile clean under both (ADR-0005). -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="NuGet package metadata">
    <!--
      No <Version> here on purpose. The git tag is the version, derived by MinVer (ADR-0006).
      This element last declared 1.0.6, a version that had never been tagged or released.
    -->
    <PackageId>MarqSpec.Client.ProjectX</PackageId>
    <Authors>Adam Marquette</Authors>
    <Company>MarqSpec</Company>
    <Description>A .NET client library for the ProjectX API, providing REST and WebSocket connectivity with SignalR support.</Description>
    <PackageTags>ProjectX;API;Client;SignalR;WebSocket;Trading</PackageTags>
    <RepositoryUrl>https://github.com/adammarquette/MarqSpec.Client.ProjectX</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/adammarquette/MarqSpec.Client.ProjectX</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Symbol package for debugging (R-10.3). The PRD asked for this; nothing produced it. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Refit" />
    <PackageReference Include="Refit.HttpClientFactory" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <!-- The gateway retry predicate (ShouldRetryOutcome / IsOrderPlacement) is internal but safety-critical
         (gh#629 — a place must never be auto-retried), so its unit tests exercise the real methods. -->
    <InternalsVisibleTo Include="MarqSpec.Client.ProjectX.Tests" />
  </ItemGroup>

</Project>
