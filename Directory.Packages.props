<Project>

  <!--
    Central Package Management — .csproj files carry no versions.

    This exists because they had drifted: the library pinned Microsoft.Extensions.* at 9.0.3 while
    Samples and Diagnostics pulled 10.0.0 of the same packages, which is how a downgrade warning
    appears the moment they compose.

    The library's dependency surface is part of its public contract (R-10.5) — trading-copilot
    compiles against this assembly, so a version conflict here becomes their problem. Adding a
    dependency needs a line in the PR saying why, and it must support net8.0, not just restore
    (ADR-0005).
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Build">
    <!-- Versioning from the git tag (ADR-0006). Build-time only; never a runtime dependency. -->
    <PackageVersion Include="MinVer" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup Label="Library — transport">
    <PackageVersion Include="Refit" Version="9.0.2" />
    <PackageVersion Include="Refit.HttpClientFactory" Version="9.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="Library — resilience">
    <!--
      Http.Resilience and Polly.Core ship from dotnet/extensions, a different release train from the
      Microsoft.Extensions.* packages below, so their versions are not expected to match.
    -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageVersion Include="Polly.Core" Version="8.6.5" />
  </ItemGroup>

  <ItemGroup Label="Library — configuration, options, logging">
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Apps and tests — configuration hosts">
    <!-- Unified at the library's 9.0.3: Samples and Diagnostics were on 10.0.0. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="9.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup Label="Test stack">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="FakeItEasy" Version="8.0.0" />
    <!-- LICENSE CAP: FluentAssertions v8+ is commercially licensed. Do not bump past 7.x. -->
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

</Project>
